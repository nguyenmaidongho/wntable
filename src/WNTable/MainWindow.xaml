<Window x:Class="WNTable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WNTable.Controls"
        Style="{DynamicResource AppWindow}"
        Title="WebNowTable" Width="780" Height="480" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: brand + actions -->
        <Border Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,28,20,16">
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"
                           Text="Enter: kết nối · F2: sửa · Del: xoá&#10;Ctrl+N: kết nối mới · Ctrl+O: mở SQLite" />
                <StackPanel>
                    <Image Source="pack://application:,,,/Assets/logo-mark.png" Width="72" Height="72"
                           RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
                    <TextBlock Text="WebNowTable" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,24" />

                    <Button Style="{StaticResource PrimaryButton}" Click="New_Click" MinHeight="28" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Tạo kết nối mới" />
                        </StackPanel>
                    </Button>
                    <Button Click="OpenSqlite_Click" MinHeight="28" HorizontalContentAlignment="Left" Padding="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,8,0" />
                            <TextBlock Text="Mở file SQLite…" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right: connections -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Padding="12,12,12,8">
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" controls:Hint.Text="Tìm kết nối…"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
            </Border>
            <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="16,6,16,10" TextWrapping="Wrap"
                       Style="{StaticResource Muted}" FontSize="11" />
            <Grid>
                <ListBox x:Name="ConnectionList" MouseDoubleClick="ConnectionList_MouseDoubleClick" KeyDown="ConnectionList_KeyDown"
                         Padding="4,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Kết nối" Click="Connect_Click" InputGestureText="Enter" />
                            <MenuItem Header="Sửa…" Click="Edit_Click" InputGestureText="F2" />
                            <MenuItem Header="Nhân bản" Click="Duplicate_Click" />
                            <Separator />
                            <MenuItem Header="Xoá" Click="Delete_Click" InputGestureText="Del" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="7" Margin="0,0,10,0"
                                        Background="{Binding Color, Converter={x:Static controls:ColorBrushConverter.Instance}}">
                                    <TextBlock Text="{Binding Kind, Converter={x:Static controls:KindBadgeConverter.Instance}}"
                                               Foreground="White" FontWeight="SemiBold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static controls:ColorBrushConverter.Instance}}"
                                        Visibility="{Binding Color, Converter={x:Static controls:EnvTagVisibilityConverter.Instance}}">
                                    <TextBlock Text="{Binding Color, Converter={x:Static controls:EnvTagConverter.Instance}}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="Chưa có kết nối nào" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0"
                               Text="Tạo kết nối MySQL, PostgreSQL, SQL Server&#10;hoặc mở một file SQLite." />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
