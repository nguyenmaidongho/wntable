<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette, modelled on TablePlus' default look. -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#EFEFF1" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DCDCE0" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#ECECEF" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A8A8E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F74EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2566D6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D6E4FB" />
    <SolidColorBrush x:Key="SelectionStrongBrush" Color="#2F74EB" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#F7F7F8" />
    <SolidColorBrush x:Key="AltRowBrush" Color="#FAFAFB" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E6E6E9" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DADADE" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CFCFD4" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C4C8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#30A46C" />
    <SolidColorBrush x:Key="ModifiedBrush" Color="#FFF6D6" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#33000000" />
</ResourceDictionary>
