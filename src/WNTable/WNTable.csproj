<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WNTable.Core\WNTable.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\SQL.xshd" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-mark.png" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyTitle>WebNowTable</AssemblyTitle>
    <Product>WebNowTable</Product>
    <Description>WebNowTable (WNTable) — database client gọn nhẹ cho Windows</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
