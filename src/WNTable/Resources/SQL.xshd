<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="SQL" extensions=".sql" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <!-- Foregrounds are replaced at load time with the light or dark palette (see SqlEditor). -->
  <Color name="Comment" foreground="#6A9955" fontStyle="italic" />
  <Color name="String" foreground="#CE9178" />
  <Color name="Identifier" foreground="#9CDCFE" />
  <Color name="Number" foreground="#B5CEA8" />
  <Color name="Keyword" foreground="#569CD6" fontWeight="bold" />
  <Color name="Function" foreground="#DCDCAA" />
  <Color name="Variable" foreground="#C586C0" />

  <RuleSet ignoreCase="true">
    <Span color="Comment" begin="--" />
    <Span color="Comment" begin="\#" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="String">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>
    <Span color="Identifier" begin="&quot;" end="&quot;" />
    <Span color="Identifier" begin="`" end="`" />
    <Span color="Identifier" begin="\[" end="\]" />
    <Span color="String" multiline="true" begin="\$\$" end="\$\$" />

    <Rule color="Variable">@@?[A-Za-z_][A-Za-z0-9_]*|:[A-Za-z_][A-Za-z0-9_]*</Rule>
    <Rule color="Number">\b0x[0-9a-fA-F]+\b|\b\d+(\.\d+)?([eE][+-]?\d+)?\b</Rule>

    <Keywords color="Keyword">
      <Word>ADD</Word><Word>ALL</Word><Word>ALTER</Word><Word>AND</Word><Word>ANY</Word><Word>AS</Word><Word>ASC</Word>
      <Word>AUTO_INCREMENT</Word><Word>BEGIN</Word><Word>BETWEEN</Word><Word>BY</Word><Word>CALL</Word><Word>CASCADE</Word>
      <Word>CASE</Word><Word>CHECK</Word><Word>COLUMN</Word><Word>COMMIT</Word><Word>CONSTRAINT</Word><Word>CREATE</Word>
      <Word>CROSS</Word><Word>DATABASE</Word><Word>DEFAULT</Word><Word>DELETE</Word><Word>DESC</Word><Word>DESCRIBE</Word>
      <Word>DISTINCT</Word><Word>DROP</Word><Word>ELSE</Word><Word>END</Word><Word>ENGINE</Word><Word>EXCEPT</Word>
      <Word>EXEC</Word><Word>EXECUTE</Word><Word>EXISTS</Word><Word>EXPLAIN</Word><Word>FALSE</Word><Word>FETCH</Word>
      <Word>FOREIGN</Word><Word>FROM</Word><Word>FULL</Word><Word>FUNCTION</Word><Word>GRANT</Word><Word>GROUP</Word>
      <Word>HAVING</Word><Word>IF</Word><Word>ILIKE</Word><Word>IN</Word><Word>INDEX</Word><Word>INNER</Word><Word>INSERT</Word>
      <Word>INTERSECT</Word><Word>INTO</Word><Word>IS</Word><Word>JOIN</Word><Word>KEY</Word><Word>LEFT</Word><Word>LIKE</Word>
      <Word>LIMIT</Word><Word>NEXT</Word><Word>NOT</Word><Word>NULL</Word><Word>OFFSET</Word><Word>ON</Word><Word>ONLY</Word>
      <Word>OR</Word><Word>ORDER</Word><Word>OUTER</Word><Word>OVER</Word><Word>PARTITION</Word><Word>PRIMARY</Word>
      <Word>PROCEDURE</Word><Word>REFERENCES</Word><Word>RENAME</Word><Word>REPLACE</Word><Word>RETURNING</Word>
      <Word>RETURNS</Word><Word>REVOKE</Word><Word>RIGHT</Word><Word>ROLLBACK</Word><Word>ROWS</Word><Word>SCHEMA</Word>
      <Word>SELECT</Word><Word>SET</Word><Word>SHOW</Word><Word>TABLE</Word><Word>TABLES</Word><Word>THEN</Word><Word>TOP</Word>
      <Word>TRANSACTION</Word><Word>TRIGGER</Word><Word>TRUE</Word><Word>TRUNCATE</Word><Word>UNION</Word><Word>UNIQUE</Word>
      <Word>UPDATE</Word><Word>USE</Word><Word>USING</Word><Word>VALUES</Word><Word>VIEW</Word><Word>WHEN</Word><Word>WHERE</Word>
      <Word>WITH</Word><Word>DECLARE</Word><Word>RETURN</Word><Word>WHILE</Word><Word>LANGUAGE</Word><Word>UNSIGNED</Word>
      <Word>INT</Word><Word>INTEGER</Word><Word>BIGINT</Word><Word>SMALLINT</Word><Word>TINYINT</Word><Word>DECIMAL</Word>
      <Word>NUMERIC</Word><Word>FLOAT</Word><Word>DOUBLE</Word><Word>REAL</Word><Word>VARCHAR</Word><Word>NVARCHAR</Word>
      <Word>CHAR</Word><Word>TEXT</Word><Word>BOOLEAN</Word><Word>BOOL</Word><Word>DATE</Word><Word>DATETIME</Word>
      <Word>TIMESTAMP</Word><Word>TIME</Word><Word>JSON</Word><Word>JSONB</Word><Word>UUID</Word><Word>BLOB</Word><Word>SERIAL</Word>
    </Keywords>

    <Keywords color="Function">
      <Word>COUNT</Word><Word>SUM</Word><Word>AVG</Word><Word>MIN</Word><Word>MAX</Word><Word>COALESCE</Word><Word>IFNULL</Word>
      <Word>ISNULL</Word><Word>NULLIF</Word><Word>CAST</Word><Word>CONVERT</Word><Word>CONCAT</Word><Word>CONCAT_WS</Word>
      <Word>SUBSTRING</Word><Word>SUBSTR</Word><Word>LENGTH</Word><Word>LEN</Word><Word>LOWER</Word><Word>UPPER</Word>
      <Word>TRIM</Word><Word>ROUND</Word><Word>NOW</Word><Word>CURRENT_DATE</Word><Word>CURRENT_TIMESTAMP</Word>
      <Word>DATE_FORMAT</Word><Word>DATEADD</Word><Word>DATEDIFF</Word><Word>GETDATE</Word><Word>GROUP_CONCAT</Word>
      <Word>STRING_AGG</Word><Word>ROW_NUMBER</Word><Word>RANK</Word><Word>DENSE_RANK</Word><Word>ABS</Word><Word>FLOOR</Word><Word>CEIL</Word>
    </Keywords>
  </RuleSet>
</SyntaxDefinition>
